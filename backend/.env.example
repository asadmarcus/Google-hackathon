# ═══════════════════════════════════════════════════════════
# CIRO Backend — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy to .env: copy .env.example .env

# ─── API Keys (Optional — system works without these) ─────
# OpenWeatherMap: https://openweathermap.org/api (free, 2 min signup)
OPENWEATHER_API_KEY=

# Google Maps: https://console.cloud.google.com ($200 free credit)
GOOGLE_MAPS_API_KEY=

# ─── Firebase (Optional — using SQLite by default) ────────
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# ─── Configuration ────────────────────────────────────────
ENVIRONMENT=development
FETCH_INTERVAL_MINUTES=15
SIGNAL_BUFFER_DAYS=30
SEVERITY_THRESHOLD=0.7
